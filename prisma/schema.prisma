// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// npx prisma db push
// npx prisma generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(cuid())
  githubId   String   @unique
  userName   String
  email      String?
  avatarUrl  String?
  createdAt  DateTime @default(now())

  growthDiaries GrowthDiary[]
  chats         Chat[]
}

model GithubEvent {
  id         String   @id
  userLogin  String
  type       String
  repoId     BigInt
  repoName   String
  payload    Json
  createdAt  DateTime
}


model WeeklySummary {
  id         String   @id @default(cuid())
  userLogin  String
  weekStart  DateTime

  summary    Json
  calendar   Json
  commits    Json

  analysis   Json?

  createdAt  DateTime @default(now())

  @@unique([userLogin, weekStart])
}

model MonthlySummary {
  id            String   @id @default(cuid())
  userLogin     String
  month         String

  summary       Json
  repo          Json

  analysis      Json?
  growthPoint   Json?

  createdAt     DateTime @default(now())

  @@unique([userLogin, month])
}

model GrowthDiary {
  id        String   @id @default(cuid())
  userId    String
  diaryDate DateTime @db.Date
  title     String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [githubId], onDelete: Cascade)

  @@unique([userId, diaryDate])
  @@index([userId, diaryDate])
}

enum ChatRole {
  USER
  ASSISTANT
}

model Chat {
  id          String    @id @default(cuid())
  userId      String
  role        ChatRole
  content     String
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [githubId], onDelete: Cascade)

  @@index([userId, createdAt])
}